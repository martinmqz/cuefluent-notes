{
  "name": "cuefluent-notes",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "description": "Selected session evidence and searchable Markdown notes with independent collection and processing.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "guidance:sync": "agent-guidance sync",
    "check:guidance": "agent-guidance check",
    "install:codex": "node scripts/install.mjs --client codex",
    "install:claude": "node scripts/install.mjs --client claude",
    "test": "node scripts/test.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "package": "node scripts/package.mjs",
    "package:hooks": "node scripts/package.mjs --hooks",
    "release:build": "node scripts/release.mjs"
  },
  "dependencies": {
    "markdown-it": "15.0.2",
    "markdown-it-footnote": "4.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@martinmqz/agent-guidance-sync": "0.1.2",
    "fflate": "0.8.3",
    "tar-stream": "3.2.1"
  },
  "license": "SUL-1.0"
}
