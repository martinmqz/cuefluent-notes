{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'src','cli.mjs');const r=require('node:child_process').spawnSync(process.execPath,[p,'hook','codex'],{stdio:'inherit'});process.exitCode=r.status??1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'src','cli.mjs');const r=require('node:child_process').spawnSync(process.execPath,[p,'hook','codex'],{stdio:'inherit'});process.exitCode=r.status??1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'src','cli.mjs');const r=require('node:child_process').spawnSync(process.execPath,[p,'hook','codex'],{stdio:'inherit'});process.exitCode=r.status??1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'src','cli.mjs');const r=require('node:child_process').spawnSync(process.execPath,[p,'hook','codex'],{stdio:'inherit'});process.exitCode=r.status??1\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('node:path').join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'src','cli.mjs');const r=require('node:child_process').spawnSync(process.execPath,[p,'hook','codex'],{stdio:'inherit'});process.exitCode=r.status??1\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
