* text=auto eol=lf
*.png binary
*.jpg binary
*.zip binary
*.gz binary

# Preserve published bytes; edit source/templates and publish a new release.
plugins/** -text linguist-generated=true
claude/** -text linguist-generated=true
# Third-party whitespace is part of the immutable published package bytes.
plugins/**/node_modules/** -whitespace
claude/**/node_modules/** -whitespace
plugins/**/THIRD_PARTY_NOTICES.md -whitespace
claude/**/THIRD_PARTY_NOTICES.md -whitespace
